   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GetRelationString", "[", 
     RowBox[{
     "i_", ",", " ", "c_", ",", " ", "p3_", ",", " ", "n3_", ",", " ", "m3_", 

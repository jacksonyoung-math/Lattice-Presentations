    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"v", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "/", "Delt"}], "]"}], "^", "2"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 

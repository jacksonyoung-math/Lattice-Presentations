   RowBox[{
    RowBox[{"s", " ", "=", " ", "\"\<F<R, Tv, T1, Ttau, \>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"co", " ", "=", " ", "1"}], ",", " ", 

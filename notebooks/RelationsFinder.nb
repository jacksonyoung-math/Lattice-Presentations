Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Convert", " ", "from", " ", "horospherical", " ", "coordinates", " ", 
    RowBox[{"(", 
     RowBox[{"z", ",", " ", "t", ",", " ", "0"}], ")"}], " ", "to", " ", 
    "complex", " ", "projective", " ", "coordinates", " ", 
    RowBox[{"(", 
     RowBox[{"z1", ",", " ", "z2", ",", " ", "z3"}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"HorosphereToCP", "[", "v_", "]"}], " ", ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", " ", 
            RowBox[{"Conjugate", "[", 
             RowBox[{"v", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "*", 
           RowBox[{"v", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ")"}], " ", "+", 
         RowBox[{"I", " ", "*", " ", 
          RowBox[{"v", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], "/", "2"}], ",", " ", 
      RowBox[{"v", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", " ", "1"}], "}"}]}], " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CPToHorosphere", "[", "v_", "]"}], " ", ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"v", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "/", 
       RowBox[{"v", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
      RowBox[{"Im", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", 
          RowBox[{
           RowBox[{"v", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "/", 
           RowBox[{"v", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"v", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "/", 
            RowBox[{"v", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "^", "2"}]}], ")"}], 
       "]"}], ",", " ", 
      RowBox[{"-", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"2", "*", 
          RowBox[{
           RowBox[{"v", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "/", 
           RowBox[{"v", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], "+", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"v", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "/", 
            RowBox[{"v", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "^", "2"}]}], "]"}]}]}],
      "}"}]}], " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "The", " ", "standard", " ", "lift", " ", "of", " ", "a", " ", "point", " ",
      "in", " ", "horospherical", " ", "coordinates", " ", 
     RowBox[{"{", 
      RowBox[{"z", ",", " ", "t", ",", " ", "u"}], "}"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"StandardLift", "[", "w_", "]"}], " ", ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"w", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "^", "2"}]}], "-", 
         RowBox[{"w", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "+", 
         RowBox[{"I", " ", "*", " ", 
          RowBox[{"w", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], "/", "2"}], ",", " ", 
      RowBox[{"w", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", " ", "1"}], "}"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Compute", " ", "hermitian", " ", "inner", " ", "product"}], " ", 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"HermitianInnerProduct", "[", 
     RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"ConjugateTranspose", "[", "b", "]"}], ".", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}], ".", 
     "a"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{

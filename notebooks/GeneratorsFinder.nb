Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Get", " ", "Gamma", " ", "given", " ", "certain", " ", "powers"}],
    " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GetGamma", "[", 
     RowBox[{"p_", ",", " ", "n_", ",", " ", "m_", ",", " ", "l_"}], "]"}], 
    " ", ":=", " ", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "r", ",", " ", "z1", ",", " ", "z2", ",", " ", "t1", ",", " ", "t2", ",",
         " ", "top"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"R", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"z1", " ", "=", " ", 
        RowBox[{"T1", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "3"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"z2", " ", "=", " ", 
        RowBox[{"Ttau", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "3"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"t1", " ", "=", " ", 
        RowBox[{"2", "*", 
         RowBox[{"Im", "[", 
          RowBox[{"T1", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "3"}], "]"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"t2", " ", "=", " ", 
        RowBox[{"2", "*", 
         RowBox[{"Im", "[", 
          RowBox[{"Ttau", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "3"}], "]"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"top", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 

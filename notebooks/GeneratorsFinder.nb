                 RowBox[{"Conjugate", "[", "d", "]"}]}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"det", "*", "c"}], ")"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"z", " ", "=", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"det", "*", "b", "*", "d"}], "-", 
                 RowBox[{"Conjugate", "[", "c", "]"}]}], ")"}], "/", 

             RowBox[{
              RowBox[{"Abs", "[", "z2", "]"}], "^", "2"}]}], "-", 
            RowBox[{
             RowBox[{"m", "^", "2"}], "*", 
             RowBox[{
              RowBox[{"Abs", "[", "z1", "]"}], "^", "2"}]}], "-", 

       "a", ",", " ", "b", ",", " ", "c", ",", " ", "i", ",", " ", "j", ",", 
        " ", "k", ",", " ", "d", ",", " ", "e", ",", " ", "x", ",", " ", "y", 
        ",", " ", "z", ",", " ", "w", ",", " ", "A", ",", " ", "listy"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 

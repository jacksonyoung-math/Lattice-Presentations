      " ", "determinant", " ", 
     RowBox[{"suffices", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GetGenerator", "[", 
     RowBox[{"pll_", ",", " ", "plllist_", ",", " ", "det_"}], "]"}], " ", ":=",
     " ", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 

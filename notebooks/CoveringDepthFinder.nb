    RowBox[{"depth", " ", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pllprismlist", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rationalpoints", " ", "=", " ", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{"!", "isCovered"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nextdepth", " ", "=", " ", 
        RowBox[{"depth", " ", "+", " ", "1"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"ScaleFactorsOfDepth", "[", "nextdepth", "]"}], "]"}], "==",
           " ", "0"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"nextdepth", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"height", " ", "=", "  ", 
        RowBox[{"GetSmall", "[", " ", 
         RowBox[{
          RowBox[{"GetHeight", "[", "nextdepth", "]"}], ",", "  ", 
          RowBox[{"GetHeight", "[", "depth", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "Find", " ", "the", " ", "depth", " ", "n", " ", "points", " ", "in",
           " ", "the", " ", "fundamental", " ", "domain"}], ",", " ", 
         RowBox[{
         "then", " ", "package", " ", "with", " ", "their", " ", "depth", " ",
           "and", " ", "include", " ", "in", " ", 
          RowBox[{"rationalpoints", ".", " ", "Meanwhile"}]}], ",", " ", 
         RowBox[{
         "record", " ", "the", " ", "PLLs", " ", "that", " ", "are", " ", 
          "contained", " ", "in", " ", "the", " ", "prism", " ", "in", " ", 
          "the", " ", "file", " ", "specified", " ", "by", " ", "the", " ", 
          RowBox[{"directory", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"depthNpoints", " ", "=", " ", 
        RowBox[{"PLLsOfDepthNIntersectingPrismAtHeightU", "[", 
         RowBox[{"depth", ",", " ", "height"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", " ", "1"}], ",", " ", 
         RowBox[{"j", "<=", " ", 
          RowBox[{"Length", "[", "depthNpoints", "]"}]}], ",", " ", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"testpoint", " ", "=", " ", 
           RowBox[{"depthNpoints", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"rationalpoints", " ", "=", " ", 
           RowBox[{"Append", "[", 
            RowBox[{"rationalpoints", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"CPToHorosphere", "[", "testpoint", "]"}], "//", 
                "ComplexExpand"}], ",", " ", "depth"}], "}"}]}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"InPrism", "[", 
             RowBox[{"CPToHorosphere", "[", "testpoint", "]"}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"pllprismlist", " ", "=", " ", 
              RowBox[{"Append", "[", 
               RowBox[{"pllprismlist", ",", " ", "testpoint"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Write", "[", 
              RowBox[{"strPLLs", ",", " ", "testpoint"}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"isCovered", " ", "=", " ", 
        RowBox[{"CheckCoveringDepth", "[", 
         RowBox[{"rationalpoints", ",", " ", "height"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", "isCovered"}], ",", " ", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<... not covered at depth \>\"", ",", " ", "depth"}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"prevdepth", " ", "=", " ", "depth"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"depth", " ", "=", " ", "nextdepth"}], ";"}]}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Covering depth is \>\"", ",", " ", "prevdepth"}], "]"}], 
    ";"}]}]}]], "Input",

  RowBox[{
   RowBox[{
    RowBox[{"strPLLs", " ", "=", " ", 
     RowBox[{"OpenWrite", "[", 
      RowBox[{"dir", "<>", "foutputPLLs"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"isCovered", " ", "=", " ", "False"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"prevdepth", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 

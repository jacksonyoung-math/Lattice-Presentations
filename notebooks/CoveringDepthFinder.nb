Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Find", " ", "small", " ", "rational", " ", "between", " ", "two", " ", 
     "heights", " ", "a"}], " ", "<", " ", "b"}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GetSmall", "[", 
      RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "eps", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"eps", " ", "=", " ", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a", "+", "b"}], ")"}], "/", "2"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"eps", " ", "-", " ", "a"}], "]"}], " ", ">", " ", 
           "0.0001"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"eps", " ", "=", " ", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "+", "eps"}], ")"}], "/", "2"}], "]"}]}], ";"}]}],
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "eps", "]"}], ";"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Intersection", " ", "height", " ", "u", 
     RowBox[{"(", "n", ")"}], " ", "from", " ", "depth", " ", "n"}], " ", 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GetHeight", "[", "depth_", "]"}], " ", ":=", " ", 
    RowBox[{"2", "*", 
     RowBox[{
      RowBox[{"Abs", "[", "Alph", "]"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Abs", "[", "Delt", "]"}], "*", 
        RowBox[{"Sqrt", "[", "depth", "]"}]}], ")"}]}]}]}]}]}]], "Input",
